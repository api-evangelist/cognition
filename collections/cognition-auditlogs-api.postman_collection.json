          "id": "42744540-0bc6-4182-aee4-6ec3a7ef9fb3",
          "name": "List all audit logs",
          "request": {
            "name": "List all audit logs",
            "description": {
              "content": "Get a paginated list of all audit logs for the current organization.\nThe logs are ordered by creation date in descending order (newest first).\n\nAudit logs track various actions across organization management, sessions, API keys, \nsecrets, knowledge management, playbooks, repository management, git integrations, \nenterprise settings, and search operations.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "audit-logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of audit logs to return"
                },
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<string>",
                  "description": "Filter logs before a specific timestamp"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Filter logs after a specific timestamp"
                }
              ],
              "variable": []
            },
