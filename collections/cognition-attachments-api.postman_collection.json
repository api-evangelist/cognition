        {
          "id": "5a6592ca-2a00-4513-a1ae-f083ae3437d9",
          "name": "Download attachment files",
          "request": {
            "name": "Download attachment files",
            "description": {
              "content": "Download a previously uploaded attachment file using its UUID and filename.\nThis endpoint returns a redirect to a presigned URL for the file.\n\n**Note for curl users**: Use the `-L` flag to follow the redirect automatically.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "attachments",
                ":uuid",
                ":name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "uuid",
                  "description": "(Required) The UUID of the attachment"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "name",
                  "description": "(Required) The filename of the attachment"
                }
              ]
            },
            "header": [
